// hopparch top-bar stats: CPU 12% 54° | GPU 30% 61° | RAM 8.1G
// Its own file so the minimal profile can swap it for an empty group (no
// polling at all on an old machine). Included by config.jsonc.
{
  "group/stats": {
    "orientation": "horizontal",
    "modules": ["cpu", "custom/cpu-temp", "custom/gpu", "memory"]
  },

  "cpu": {
    "interval": 3,
    "format": "CPU {usage}%",
    "tooltip": false
  },

  // no sensor found = nothing printed = the module disappears
  "custom/cpu-temp": {
    "exec": "$HOME/.config/scripts/stats.sh cpu-temp",
    "interval": 3,
    "tooltip": false
  },

  "custom/gpu": {
    "exec": "$HOME/.config/scripts/stats.sh gpu",
    "interval": 3,
    "tooltip": false
  },

  "memory": {
    "interval": 5,
    "format": "RAM {used:0.1f}G",
    "tooltip": false
  }
}
